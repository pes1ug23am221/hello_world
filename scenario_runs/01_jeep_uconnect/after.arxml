<?xml version="1.0" encoding="UTF-8"?>
<!-- Jeep Cherokee / Uconnect remote exploit (2015)
     Source: Miller & Valasek, Black Hat USA 2015; recall of 1.4M FCA vehicles
     Update path opens an unauthenticated head-unit-to-CAN-bridge hop that reaches steering. Expected: BLOCK.
-->
<AUTOSAR xmlns="http://autosar.org/schema/r4.0">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>S01UCON</SHORT-NAME>
      <AR-PACKAGES>
        <AR-PACKAGE>
          <SHORT-NAME>If</SHORT-NAME>
          <ELEMENTS>
            <SENDER-RECEIVER-INTERFACE>
              <SHORT-NAME>CellLink</SHORT-NAME>
              <DATA-ELEMENTS>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>val</SHORT-NAME>
                </VARIABLE-DATA-PROTOTYPE>
              </DATA-ELEMENTS>
            </SENDER-RECEIVER-INTERFACE>
            <SENDER-RECEIVER-INTERFACE>
              <SHORT-NAME>DbusCmd</SHORT-NAME>
              <DATA-ELEMENTS>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>val</SHORT-NAME>
                </VARIABLE-DATA-PROTOTYPE>
              </DATA-ELEMENTS>
            </SENDER-RECEIVER-INTERFACE>
            <SENDER-RECEIVER-INTERFACE>
              <SHORT-NAME>CanFrame</SHORT-NAME>
              <DATA-ELEMENTS>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>val</SHORT-NAME>
                </VARIABLE-DATA-PROTOTYPE>
              </DATA-ELEMENTS>
            </SENDER-RECEIVER-INTERFACE>
          </ELEMENTS>
        </AR-PACKAGE>
        <AR-PACKAGE>
          <SHORT-NAME>Swc</SHORT-NAME>
          <ELEMENTS>
            <APPLICATION-SW-COMPONENT-TYPE>
              <SHORT-NAME>Telematics</SHORT-NAME>
              <PORTS>
                <P-PORT-PROTOTYPE>
                  <SHORT-NAME>cellToHuOut</SHORT-NAME>
                  <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/S01UCON/If/CellLink</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
              </PORTS>
            </APPLICATION-SW-COMPONENT-TYPE>
            <APPLICATION-SW-COMPONENT-TYPE>
              <SHORT-NAME>HeadUnit</SHORT-NAME>
              <PORTS>
                <P-PORT-PROTOTYPE>
                  <SHORT-NAME>huToBridgeOut</SHORT-NAME>
                  <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/S01UCON/If/DbusCmd</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>cellToHuIn</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/S01UCON/If/CellLink</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
              </PORTS>
            </APPLICATION-SW-COMPONENT-TYPE>
            <APPLICATION-SW-COMPONENT-TYPE>
              <SHORT-NAME>V850Bridge</SHORT-NAME>
              <PORTS>
                <P-PORT-PROTOTYPE>
                  <SHORT-NAME>bridgeToSteerOut</SHORT-NAME>
                  <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/S01UCON/If/CanFrame</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>huToBridgeIn</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/S01UCON/If/DbusCmd</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
              </PORTS>
            </APPLICATION-SW-COMPONENT-TYPE>
            <APPLICATION-SW-COMPONENT-TYPE>
              <SHORT-NAME>SteeringCtrl</SHORT-NAME>
              <PORTS>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>bridgeToSteerIn</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/S01UCON/If/CanFrame</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
              </PORTS>
            </APPLICATION-SW-COMPONENT-TYPE>
            <COMPOSITION-SW-COMPONENT-TYPE>
              <SHORT-NAME>Root</SHORT-NAME>
              <COMPONENTS>
                <SW-COMPONENT-PROTOTYPE>
                  <SHORT-NAME>tel</SHORT-NAME>
                  <TYPE-TREF DEST="APPLICATION-SW-COMPONENT-TYPE">/S01UCON/Swc/Telematics</TYPE-TREF>
                </SW-COMPONENT-PROTOTYPE>
                <SW-COMPONENT-PROTOTYPE>
                  <SHORT-NAME>ivi</SHORT-NAME>
                  <TYPE-TREF DEST="APPLICATION-SW-COMPONENT-TYPE">/S01UCON/Swc/HeadUnit</TYPE-TREF>
                </SW-COMPONENT-PROTOTYPE>
                <SW-COMPONENT-PROTOTYPE>
                  <SHORT-NAME>bridge</SHORT-NAME>
                  <TYPE-TREF DEST="APPLICATION-SW-COMPONENT-TYPE">/S01UCON/Swc/V850Bridge</TYPE-TREF>
                </SW-COMPONENT-PROTOTYPE>
                <SW-COMPONENT-PROTOTYPE>
                  <SHORT-NAME>steer</SHORT-NAME>
                  <TYPE-TREF DEST="APPLICATION-SW-COMPONENT-TYPE">/S01UCON/Swc/SteeringCtrl</TYPE-TREF>
                </SW-COMPONENT-PROTOTYPE>
              </COMPONENTS>
              <CONNECTORS>
                <ASSEMBLY-SW-CONNECTOR>
                  <SHORT-NAME>cellToHu</SHORT-NAME>
                  <PROVIDER-IREF>
                    <CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/S01UCON/Swc/Root/tel</CONTEXT-COMPONENT-REF>
                    <TARGET-P-PORT-REF DEST="P-PORT-PROTOTYPE">/S01UCON/Swc/Telematics/cellToHuOut</TARGET-P-PORT-REF>
                  </PROVIDER-IREF>
                  <REQUESTER-IREF>
                    <CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/S01UCON/Swc/Root/ivi</CONTEXT-COMPONENT-REF>
                    <TARGET-R-PORT-REF DEST="R-PORT-PROTOTYPE">/S01UCON/Swc/HeadUnit/cellToHuIn</TARGET-R-PORT-REF>
                  </REQUESTER-IREF>
                </ASSEMBLY-SW-CONNECTOR>
                <ASSEMBLY-SW-CONNECTOR>
                  <SHORT-NAME>huToBridge</SHORT-NAME>
                  <PROVIDER-IREF>
                    <CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/S01UCON/Swc/Root/ivi</CONTEXT-COMPONENT-REF>
                    <TARGET-P-PORT-REF DEST="P-PORT-PROTOTYPE">/S01UCON/Swc/HeadUnit/huToBridgeOut</TARGET-P-PORT-REF>
                  </PROVIDER-IREF>
                  <REQUESTER-IREF>
                    <CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/S01UCON/Swc/Root/bridge</CONTEXT-COMPONENT-REF>
                    <TARGET-R-PORT-REF DEST="R-PORT-PROTOTYPE">/S01UCON/Swc/V850Bridge/huToBridgeIn</TARGET-R-PORT-REF>
                  </REQUESTER-IREF>
                </ASSEMBLY-SW-CONNECTOR>
                <ASSEMBLY-SW-CONNECTOR>
                  <SHORT-NAME>bridgeToSteer</SHORT-NAME>
                  <PROVIDER-IREF>
                    <CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/S01UCON/Swc/Root/bridge</CONTEXT-COMPONENT-REF>
                    <TARGET-P-PORT-REF DEST="P-PORT-PROTOTYPE">/S01UCON/Swc/V850Bridge/bridgeToSteerOut</TARGET-P-PORT-REF>
                  </PROVIDER-IREF>
                  <REQUESTER-IREF>
                    <CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/S01UCON/Swc/Root/steer</CONTEXT-COMPONENT-REF>
                    <TARGET-R-PORT-REF DEST="R-PORT-PROTOTYPE">/S01UCON/Swc/SteeringCtrl/bridgeToSteerIn</TARGET-R-PORT-REF>
                  </REQUESTER-IREF>
                </ASSEMBLY-SW-CONNECTOR>
              </CONNECTORS>
            </COMPOSITION-SW-COMPONENT-TYPE>
          </ELEMENTS>
        </AR-PACKAGE>
        <AR-PACKAGE>
          <SHORT-NAME>Comm</SHORT-NAME>
          <ELEMENTS>
            <SYSTEM-SIGNAL>
              <SHORT-NAME>huToBridgeSSig</SHORT-NAME>
            </SYSTEM-SIGNAL>
            <I-SIGNAL>
              <SHORT-NAME>huToBridgeISig</SHORT-NAME>
              <SYSTEM-SIGNAL-REF DEST="SYSTEM-SIGNAL">/S01UCON/Comm/huToBridgeSSig</SYSTEM-SIGNAL-REF>
            </I-SIGNAL>
            <I-SIGNAL-I-PDU>
              <SHORT-NAME>huToBridgeIPdu</SHORT-NAME>
              <I-SIGNAL-TO-PDU-MAPPINGS>
                <I-SIGNAL-TO-I-PDU-MAPPING>
                  <SHORT-NAME>huToBridgeMap</SHORT-NAME>
                  <I-SIGNAL-REF DEST="I-SIGNAL">/S01UCON/Comm/huToBridgeISig</I-SIGNAL-REF>
                </I-SIGNAL-TO-I-PDU-MAPPING>
              </I-SIGNAL-TO-PDU-MAPPINGS>
            </I-SIGNAL-I-PDU>
            <SYSTEM-SIGNAL>
              <SHORT-NAME>bridgeToSteerSSig</SHORT-NAME>
            </SYSTEM-SIGNAL>
            <I-SIGNAL>
              <SHORT-NAME>bridgeToSteerISig</SHORT-NAME>
              <SYSTEM-SIGNAL-REF DEST="SYSTEM-SIGNAL">/S01UCON/Comm/bridgeToSteerSSig</SYSTEM-SIGNAL-REF>
            </I-SIGNAL>
            <I-SIGNAL-I-PDU>
              <SHORT-NAME>bridgeToSteerIPdu</SHORT-NAME>
              <I-SIGNAL-TO-PDU-MAPPINGS>
                <I-SIGNAL-TO-I-PDU-MAPPING>
                  <SHORT-NAME>bridgeToSteerMap</SHORT-NAME>
                  <I-SIGNAL-REF DEST="I-SIGNAL">/S01UCON/Comm/bridgeToSteerISig</I-SIGNAL-REF>
                </I-SIGNAL-TO-I-PDU-MAPPING>
              </I-SIGNAL-TO-PDU-MAPPINGS>
            </I-SIGNAL-I-PDU>
          </ELEMENTS>
        </AR-PACKAGE>
        <AR-PACKAGE>
          <SHORT-NAME>Topology</SHORT-NAME>
          <ELEMENTS>
            <ECU-INSTANCE>
              <SHORT-NAME>ChassisEcu</SHORT-NAME>
            </ECU-INSTANCE>
            <ECU-INSTANCE>
              <SHORT-NAME>GatewayEcu</SHORT-NAME>
            </ECU-INSTANCE>
            <ECU-INSTANCE>
              <SHORT-NAME>TelematicsEcu</SHORT-NAME>
            </ECU-INSTANCE>
            <SYSTEM>
              <SHORT-NAME>Veh</SHORT-NAME>
              <ROOT-SOFTWARE-COMPOSITIONS>
                <ROOT-SW-COMPOSITION-PROTOTYPE>
                  <SHORT-NAME>Root</SHORT-NAME>
                  <SOFTWARE-COMPOSITION-TREF DEST="COMPOSITION-SW-COMPONENT-TYPE">/S01UCON/Swc/Root</SOFTWARE-COMPOSITION-TREF>
                </ROOT-SW-COMPOSITION-PROTOTYPE>
              </ROOT-SOFTWARE-COMPOSITIONS>
              <MAPPINGS>
                <SYSTEM-MAPPING>
                  <SHORT-NAME>Map</SHORT-NAME>
                  <DATA-MAPPINGS>
                    <SENDER-RECEIVER-TO-SIGNAL-MAPPING>
                      <DATA-ELEMENT-IREF>
                        <CONTEXT-COMPOSITION-REF DEST="ROOT-SW-COMPOSITION-PROTOTYPE">/S01UCON/Topology/Veh/Root</CONTEXT-COMPOSITION-REF>
                        <CONTEXT-PORT-REF DEST="P-PORT-PROTOTYPE">/S01UCON/Swc/HeadUnit/huToBridgeOut</CONTEXT-PORT-REF>
                        <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/S01UCON/If/DbusCmd/val</TARGET-DATA-PROTOTYPE-REF>
                      </DATA-ELEMENT-IREF>
                      <SYSTEM-SIGNAL-REF DEST="SYSTEM-SIGNAL">/S01UCON/Comm/huToBridgeSSig</SYSTEM-SIGNAL-REF>
                    </SENDER-RECEIVER-TO-SIGNAL-MAPPING>
                    <SENDER-RECEIVER-TO-SIGNAL-MAPPING>
                      <DATA-ELEMENT-IREF>
                        <CONTEXT-COMPOSITION-REF DEST="ROOT-SW-COMPOSITION-PROTOTYPE">/S01UCON/Topology/Veh/Root</CONTEXT-COMPOSITION-REF>
                        <CONTEXT-PORT-REF DEST="P-PORT-PROTOTYPE">/S01UCON/Swc/V850Bridge/bridgeToSteerOut</CONTEXT-PORT-REF>
                        <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/S01UCON/If/CanFrame/val</TARGET-DATA-PROTOTYPE-REF>
                      </DATA-ELEMENT-IREF>
                      <SYSTEM-SIGNAL-REF DEST="SYSTEM-SIGNAL">/S01UCON/Comm/bridgeToSteerSSig</SYSTEM-SIGNAL-REF>
                    </SENDER-RECEIVER-TO-SIGNAL-MAPPING>
                  </DATA-MAPPINGS>
                  <SW-MAPPINGS>
                    <SWC-TO-ECU-MAPPING>
                      <SHORT-NAME>ToChassisEcu</SHORT-NAME>
                      <COMPONENT-IREFS>
                        <COMPONENT-IREF>
                          <TARGET-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/S01UCON/Swc/Root/steer</TARGET-COMPONENT-REF>
                        </COMPONENT-IREF>
                      </COMPONENT-IREFS>
                      <ECU-INSTANCE-REF DEST="ECU-INSTANCE">/S01UCON/Topology/ChassisEcu</ECU-INSTANCE-REF>
                    </SWC-TO-ECU-MAPPING>
                    <SWC-TO-ECU-MAPPING>
                      <SHORT-NAME>ToGatewayEcu</SHORT-NAME>
                      <COMPONENT-IREFS>
                        <COMPONENT-IREF>
                          <TARGET-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/S01UCON/Swc/Root/bridge</TARGET-COMPONENT-REF>
                        </COMPONENT-IREF>
                      </COMPONENT-IREFS>
                      <ECU-INSTANCE-REF DEST="ECU-INSTANCE">/S01UCON/Topology/GatewayEcu</ECU-INSTANCE-REF>
                    </SWC-TO-ECU-MAPPING>
                    <SWC-TO-ECU-MAPPING>
                      <SHORT-NAME>ToTelematicsEcu</SHORT-NAME>
                      <COMPONENT-IREFS>
                        <COMPONENT-IREF>
                          <TARGET-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/S01UCON/Swc/Root/tel</TARGET-COMPONENT-REF>
                        </COMPONENT-IREF>
                        <COMPONENT-IREF>
                          <TARGET-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/S01UCON/Swc/Root/ivi</TARGET-COMPONENT-REF>
                        </COMPONENT-IREF>
                      </COMPONENT-IREFS>
                      <ECU-INSTANCE-REF DEST="ECU-INSTANCE">/S01UCON/Topology/TelematicsEcu</ECU-INSTANCE-REF>
                    </SWC-TO-ECU-MAPPING>
                  </SW-MAPPINGS>
                </SYSTEM-MAPPING>
              </MAPPINGS>
            </SYSTEM>
          </ELEMENTS>
        </AR-PACKAGE>
      </AR-PACKAGES>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
