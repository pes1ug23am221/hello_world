<?xml version="1.0" encoding="UTF-8"?>
<!-- Topology + SYSTEM mapping companion to multi_instance.arxml. Parse the two
     together: this file's refs resolve into that one.

     ctrl -> BodyEcu; dl, dr -> DoorEcu. So every ctrl<->door edge is cross-ECU
     (bus-traversing, SecOC-eligible) and nothing here is RTE-local.

     ToDoor deliberately uses two COMPONENT-IREF children under one mapping to
     cover the multi-component form. -->
<AUTOSAR xmlns="http://autosar.org/schema/r4.0">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>T</SHORT-NAME>
      <AR-PACKAGES>
        <AR-PACKAGE>
          <SHORT-NAME>Topology</SHORT-NAME>
          <ELEMENTS>
            <ECU-INSTANCE>
              <SHORT-NAME>BodyEcu</SHORT-NAME>
              <CONNECTORS>
                <CAN-COMMUNICATION-CONNECTOR>
                  <SHORT-NAME>CanConn</SHORT-NAME>
                </CAN-COMMUNICATION-CONNECTOR>
              </CONNECTORS>
            </ECU-INSTANCE>
            <ECU-INSTANCE>
              <SHORT-NAME>DoorEcu</SHORT-NAME>
              <CONNECTORS>
                <CAN-COMMUNICATION-CONNECTOR>
                  <SHORT-NAME>CanConn</SHORT-NAME>
                </CAN-COMMUNICATION-CONNECTOR>
              </CONNECTORS>
            </ECU-INSTANCE>
            <SYSTEM>
              <SHORT-NAME>Veh</SHORT-NAME>
              <ROOT-SOFTWARE-COMPOSITIONS>
                <ROOT-SW-COMPOSITION-PROTOTYPE>
                  <SHORT-NAME>RootProto</SHORT-NAME>
                  <SOFTWARE-COMPOSITION-TREF DEST="COMPOSITION-SW-COMPONENT-TYPE">/T/Swc/Top</SOFTWARE-COMPOSITION-TREF>
                </ROOT-SW-COMPOSITION-PROTOTYPE>
              </ROOT-SOFTWARE-COMPOSITIONS>
              <MAPPINGS>
                <SYSTEM-MAPPING>
                  <SHORT-NAME>Map</SHORT-NAME>
                  <SW-MAPPINGS>
                    <SWC-TO-ECU-MAPPING>
                      <SHORT-NAME>ToBody</SHORT-NAME>
                      <COMPONENT-IREFS>
                        <COMPONENT-IREF>
                          <CONTEXT-COMPOSITION-REF DEST="ROOT-SW-COMPOSITION-PROTOTYPE">/T/Topology/Veh/RootProto</CONTEXT-COMPOSITION-REF>
                          <TARGET-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/T/Swc/Top/ctrl</TARGET-COMPONENT-REF>
                        </COMPONENT-IREF>
                      </COMPONENT-IREFS>
                      <ECU-INSTANCE-REF DEST="ECU-INSTANCE">/T/Topology/BodyEcu</ECU-INSTANCE-REF>
                    </SWC-TO-ECU-MAPPING>
                    <SWC-TO-ECU-MAPPING>
                      <SHORT-NAME>ToDoor</SHORT-NAME>
                      <COMPONENT-IREFS>
                        <COMPONENT-IREF>
                          <CONTEXT-COMPOSITION-REF DEST="ROOT-SW-COMPOSITION-PROTOTYPE">/T/Topology/Veh/RootProto</CONTEXT-COMPOSITION-REF>
                          <TARGET-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/T/Swc/Top/dl</TARGET-COMPONENT-REF>
                        </COMPONENT-IREF>
                        <COMPONENT-IREF>
                          <CONTEXT-COMPOSITION-REF DEST="ROOT-SW-COMPOSITION-PROTOTYPE">/T/Topology/Veh/RootProto</CONTEXT-COMPOSITION-REF>
                          <TARGET-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/T/Swc/Top/dr</TARGET-COMPONENT-REF>
                        </COMPONENT-IREF>
                      </COMPONENT-IREFS>
                      <ECU-INSTANCE-REF DEST="ECU-INSTANCE">/T/Topology/DoorEcu</ECU-INSTANCE-REF>
                    </SWC-TO-ECU-MAPPING>
                  </SW-MAPPINGS>
                </SYSTEM-MAPPING>
              </MAPPINGS>
            </SYSTEM>
          </ELEMENTS>
        </AR-PACKAGE>
      </AR-PACKAGES>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
